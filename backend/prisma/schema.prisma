generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  blocked
}

// Role "primária" do usuário, denormalizada para checagens rápidas de
// autorização (ex: claim do JWT) sem precisar de join em toda requisição.
// A fonte de verdade para múltiplas roles é UserRole.
model User {
  id           String     @id @default(uuid())
  roleId       String?
  fullName     String
  email        String     @unique
  // Nulo em contas criadas via Google: não existe senha local para conferir.
  // O login por e-mail/senha recusa essas contas explicitamente.
  passwordHash String?
  // uid do Firebase, preenchido no primeiro login com Google. Numa conta que
  // já existia por e-mail/senha, o vínculo é feito no login (o Google já
  // confirmou a posse do e-mail).
  firebaseUid  String?    @unique
  phoneNumber  String?
  status       UserStatus @default(active)
  lastLoginAt  DateTime?

  // Proteção contra brute force (FASE 4): incrementado a cada login inválido,
  // zerado em login bem-sucedido. lockedUntil bloqueia novas tentativas até expirar.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Reset de senha (FASE 4): token de uso único, nunca armazenado em texto puro.
  passwordResetTokenHash  String?
  passwordResetExpiresAt DateTime?

  avatarUrl String?

  // Preferência de contato exibida em /profile/preferences.
  whatsappReminders Boolean @default(true)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  role                Role?          @relation("UserPrimaryRole", fields: [roleId], references: [id])
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  employee            Employee?
  clientAppointments  Appointment[]  @relation("ClientAppointments")
  payments            Payment[]
  notifications       Notification[]

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  usersWithPrimaryRole User[]           @relation("UserPrimaryRole")
  userRoles            UserRole[]
  rolePermissions      RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("userRoles")
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("rolePermissions")
}

// revokedAt cumpre o papel do soft delete: token revogado = inválido.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refreshTokens")
}

model Service {
  id          String    @id @default(uuid())
  name        String
  description String?
  category    String // hair | nails | makeup | brows
  duration    Int // minutos
  price       Decimal   @db.Decimal(10, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  appointments AppointmentService[]

  @@index([active])
  @@index([category])
  @@index([deletedAt])
  @@map("services")
}

model Employee {
  id        String    @id @default(uuid())
  userId    String    @unique
  hireDate  DateTime
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([active])
  @@index([deletedAt])
  @@map("employees")
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}

model Appointment {
  id          String            @id @default(uuid())
  clientId    String
  employeeId  String?
  // Agendamento já nasce confirmado: sem etapa de aprovação manual do
  // admin — ninguém agenda um corte sem saber se vai comparecer.
  status      AppointmentStatus @default(confirmed)
  scheduledAt DateTime

  // Totais dos serviços escolhidos, congelados no momento do agendamento:
  // preço/duração do catálogo podem mudar depois e não devem alterar
  // retroativamente um agendamento já feito (histórico financeiro e o
  // conflict-check precisam do valor "congelado"). A quebra por serviço fica
  // em AppointmentService.
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)

  // Como a cliente escolheu pagar. "on_site" paga no salão depois do serviço
  // (nasce pending e a equipe confirma); pix/card só chegam a existir como
  // agendamento depois do pagamento aprovado, então nascem paid.
  paymentMethod PaymentMethod @default(on_site)
  paymentStatus PaymentStatus @default(pending)

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client   User                 @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  // Restrict, e não SetNull: um agendamento sem profissional não entra no
  // conflict-check nem na constraint de sobreposição — viraria um horário
  // fantasma. Excluir funcionária é soft delete (employees.repository), então
  // isso só barra remoção manual no banco, que é justamente a intenção.
  employee Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  services AppointmentService[]
  payment  Payment?

  @@index([clientId])
  @@index([employeeId, scheduledAt])
  @@index([status])
  @@index([deletedAt])
  @@map("appointments")
}

enum PaymentMethod {
  pix
  card
  on_site
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  refunded
}

// Cobrança online (pix/cartão). Existe ANTES do agendamento: a regra do salão
// é reservar o horário só depois do pagamento aprovado, então aqui ficam os
// dados do agendamento pretendido até a confirmação chegar do provedor.
// "on_site" não passa por aqui — não há cobrança a fazer.
model Payment {
  id       String        @id @default(uuid())
  clientId String
  method   PaymentMethod
  status   PaymentStatus @default(pending)
  amount   Decimal       @db.Decimal(10, 2)

  // Agendamento pretendido. O snapshot dos serviços (id, nome, preço, duração)
  // fica em JSON porque ainda não existe Appointment para pendurar os itens —
  // e é ele, não o catálogo, que vale na hora de criar: a cliente paga o que
  // viu na tela, mesmo que o preço mude no meio do caminho.
  employeeId      String
  scheduledAt     DateTime
  durationMinutes Int
  services        Json
  notes           String?

  // Dados do provedor. providerPaymentId é a chave de idempotência contra
  // webhook repetido (o Mercado Pago reenvia até receber 200).
  provider          String  @default("mercadopago")
  providerPaymentId String? @unique
  checkoutUrl       String? // cartão: para onde a cliente é levada
  pixQrCode         String? // pix: copia e cola
  pixQrCodeBase64   String? // pix: imagem do QR
  failureReason     String?

  // Pix expira: passado isso a cobrança não vale mais e a cliente recomeça.
  expiresAt DateTime
  paidAt    DateTime?

  appointmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@map("payments")
}

// Uma cliente pode combinar vários procedimentos numa mesma ida ao salão
// (ex: corte + escova). Cada item guarda o próprio snapshot de preço/duração,
// para que o total do agendamento continue auditável item a item.
model AppointmentService {
  id              String  @id @default(uuid())
  appointmentId   String
  serviceId       String
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  // O mesmo serviço não se repete dentro de um agendamento: dois cortes na
  // mesma sessão seriam dois agendamentos.
  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointmentServices")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  description String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// Linha única (singleton): sempre lida/gravada como um todo, nunca por campo
// isolado — por isso "hours" guarda o horário de funcionamento como JSON em
// vez de virar uma tabela filha de 7 linhas fixas.
model SalonSettings {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  hours     Json
  updatedAt DateTime @updatedAt

  @@map("salonSettings")
}

// Trilha de auditoria: imutável por definição, nunca soft-deletada.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("auditLogs")
}
