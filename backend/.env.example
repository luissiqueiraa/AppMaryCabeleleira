PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marycabelo

CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m

REFRESH_TOKEN_EXPIRES_IN_DAYS=7

BCRYPT_SALT_ROUNDS=12

OWNER_EMAIL=
OWNER_PASSWORD=

# Firebase Admin — Console > Configurações do projeto > Contas de serviço >
# "Gerar nova chave privada". Os três valores saem do JSON baixado.
# A chave privada vai entre aspas, com os \n literais (não quebre a linha).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# --- Pagamento online (Mercado Pago) ---
# Sem o access token o pagamento online fica desligado: o app oferece apenas
# "pagar no salão". Passo a passo em docs/pagamentos-mercado-pago.md
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Endereço público deste backend (o webhook do provedor não alcança localhost)
PUBLIC_API_URL=
# Validade da cobrança pix, em minutos
PIX_EXPIRATION_MINUTES=30
